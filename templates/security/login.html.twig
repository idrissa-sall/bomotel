{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <main class="container m-auto">
        <section class="py-5 md:py-10 flex flex-col gap-4 items-start">
            <p class="text-md md:text-lg text-main font-semibold">
                AUTHENTIFICATION
            </p>
            <h1 class="text-2xl md:text-5xl font-bold max-w-2xl text-text">Connectez-vous à votre compte</h1>
        </section>
        <section class="grid grid-cols-1 pb-5 md:pb-10 gap-4 md:gap-8">
            <form class="grid grid-cols-1 gap-4" method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Déconnexion</a>
                    </div>
                {% endif %}

                <div class="col-span-1 flex flex-col gap-2">
                    <label for="username" class="text-text-secondary font-semibold">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="border border-text-secondary rounded-md text-text-secondary w-full bg-default p-1 focus:border-text-secondary focus:border-outline-2 focus:outline-offset-2 focus:outline-text-secondary" autocomplete="email" required autofocus>
                </div>
                
                <div class="col-span-1 flex flex-col gap-2">
                    <label for="password" class="text-text-secondary font-semibold">Password</label>
                    <input type="password" name="_password" id="password" class="border border-text-secondary rounded-md text-text-secondary w-full bg-default p-1 focus:border-text-secondary focus:border-outline-2 focus:outline-offset-2 focus:outline-text-secondary" autocomplete="current-password" required>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                </div>
                {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

                <div class="col-span-1">
                    {% include('partials/primary-button.html.twig')
                            with {
                                type: 'submit',
                                ariaLabel: 'Envoyer le formulaire de contact',
                                label: 'Envoyer'
                            } only 
                        %}
                </div>
            </form>
        </section>
    </main>
{% endblock %}
