<nav
    aria-label="Navigation principale"
    class="sticky top-0 z-50 text-default bg-main"
    data-controller="navbar"
    data-action="keydown.esc->navbar#close"
>
    <div class="flex flex-wrap items-center justify-between gap-4 py-6 px-4">
        <a href="{{ path('app_home') }}" class="text-xl font-bold md:text-3xl">
            <img src="{{ asset('images/logos/logo_white.png') }}" alt="todo" class="w-auto h-12">
        </a>

        <div class="order-2 ml-auto flex shrink-0 items-center gap-2 md:order-3">
            {# Bouton de réservation #}
            {% include('partials/primary-button-link.html.twig')
                with {
                    href: '#',
                    title: 'todo',
                    content: '<img src="' ~ asset('images/logos/logo_contact_hotel.png') ~ '" alt="Contact Hôtel" class="h-10 w-auto shrink-0" />',
                    label: 'Réserver',
                    labelClass: 'border-l border-main pl-1'
                } only
            %}
            <button
                type="button"
                class="group relative inline-flex size-11 items-center justify-center rounded-md
                        md:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-default"
                aria-label="Menu principal"
                aria-expanded="false"
                aria-controls="navbar-menu"
                data-navbar-target="button"
                data-action="click->navbar#toggle"
            >
                {# Burger : visible quand le menu est fermé #}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                    class="pointer-events-none absolute size-6
                            scale-100 rotate-0 opacity-100
                            transition duration-200 ease-in-out
                            group-aria-expanded:scale-75
                            group-aria-expanded:rotate-90
                            group-aria-expanded:opacity-0
                            motion-reduce:transition-none"
                >
                    <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>

                {# Croix : visible quand le menu est ouvert #}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                    class="pointer-events-none absolute size-6
                        scale-75 -rotate-90 opacity-0
                        transition duration-200 ease-in-out
                        group-aria-expanded:scale-100
                        group-aria-expanded:rotate-0
                        group-aria-expanded:opacity-100
                        motion-reduce:transition-none"
                >
                    <path stroke-linecap="round" d="m6 6 12 12M6 18 18 6"/>
                </svg>
            </button>
        </div>
        
        {# retrieve the current route #}
        {% set currentRoute = app.request.attributes.get('_route') %}

        {# Navigation hidden on mobile #}
        <div id="navbar-menu" class="order-3 hidden w-full md:order-2 md:ml-auto md:block md:w-auto" data-navbar-target="menu">
            <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-8 flex-wrap">
                <ul class="flex flex-col md:flex-row gap-4">
                    <li><a href="{{ path('app_home') }}" class="navLink md:text-lg {{ currentRoute === 'app_home' ? 'font-bold underline underline-offset-8' : 'hover:underline hover:underline-offset-8' }}">Accueil</a></li>
                    <li><a href="{{ path('app_rooms') }}" class="navLink md:text-lg {{ currentRoute === 'app_rooms' ? 'font-bold underline underline-offset-8' : 'hover:underline hover:underline-offset-8' }}">Chambres</a></li>
                    <li><a href="#" class="navLink md:text-lg {{ currentRoute === 'app_experiences' ? 'font-bold underline underline-offset-8' : 'hover:underline hover:underline-offset-8' }}">Experiences</a></li>
                    <li><a href="#" class="navLink md:text-lg {{ currentRoute === 'app_contact' ? 'font-bold underline underline-offset-8' : 'hover:underline hover:underline-offset-8' }}">Contact</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>
    
