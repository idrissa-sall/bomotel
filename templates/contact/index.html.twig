{% extends 'base.html.twig' %}

{% block title %}Hello ContactController!{% endblock %}

{% block body %}
    <main class="container m-auto">
        <section class="py-5 md:py-10 flex flex-col gap-4 items-start">
            <p class="text-md md:text-lg text-main font-semibold">
                CONTACT & ACCÈS
            </p>
            <h1 class="text-2xl md:text-5xl font-bold max-w-2xl text-text">Pour toute demande d'information</h1>
        </section>
        <section class="border-y-2 border-main grid md:grid-cols-3 grid-cols-2">
            <div class="col-span-1 border-r border-text-secondary p-5">
                <p class="text-main text-sm md:mb-3">ADRESSE</p>
                <address class="text-text-secondary font-semibold">
                    <p>
                        2 route de moulins<br>
                        03100 Montluçon, France
                    </p>
                </address>
            </div>
            <div class="col-span-1 md:border-r border-text-secondary p-5">
                <p class="text-main text-sm md:mb-3">RÉCEPTION</p>
                <p class="text-text-secondary font-semibold">
                    <a href="tel:+33470057622">+33470057622</a>
                </p>
                <p class="text-main font-semibold">
                    <a href="mailto:bomotel@wanadoo.fr">bomotel@wanadoo.fr</a>
                </p>
            </div>
            <div class="col-span-2 md:col-span-1 p-5 border-t border-text-secondary md:border-t-0 text-center md:text-start">
                <p class="text-main text-sm md:mb-3">ACCÈS</p>
                <p class="text-text-secondary font-semibold">Gare SNCF: 8mn</p>
                <p class="text-text-secondary font-semibold">Centre ville: 8mn</p>
                <p class="text-text-secondary font-semibold">Parking privé gratuit sous vidéo-surveillance</p>
            </div>
        </section>
        <section class="grid grid-cols-1 md:grid-cols-2 py-5 md:py-10 gap-4 md:gap-8">
            <div class="col-span-1 space-y-3 md:space-y-5">
                <h1 class="font-bold text-text text-xl md:text-3xl">
                    Écrivez-nous
                </h1>
                <p class="text-text-secondary text-sm max-w-lg">
                    Groupe, séminaire, court ou long séjour, demande particulière:  décrivez, on revient vers vous.
                </p>
                <form class="grid grid-cols-1 gap-4">
                    <div class="col-span-1 flex flex-col gap-2">
                        <label for="nom" class="text-text-secondary font-semibold">Nom</label>
                        <input type="text" id="nom" class="border border-text-secondary rounded-md text-text-secondary w-full bg-default p-1 focus:border-text-secondary focus:border-outline-2 focus:outline-offset-2 focus:outline-text-secondary">
                    </div>
                    <div class="col-span-1 flex flex-col gap-2">
                        <label for="email" class="text-text-secondary font-semibold">Email</label>
                        <input type="email" id="email" class="border border-text-secondary rounded-md text-text-secondary w-full bg-default p-1 focus:border-text-secondary focus:border-outline-2 focus:outline-offset-2 focus:outline-text-secondary">
                    </div>
                    <div class="col-span-1 flex flex-col gap-2">
                        <label for="subject" class="text-text-secondary font-semibold">Sujet</label>
                        <input type="text" id="subject" class="border border-text-secondary rounded-md text-text-secondary w-full bg-default p-1 focus:border-text-secondary focus:border-outline-2 focus:outline-offset-2 focus:outline-text-secondary">
                    </div>
                    <div class="col-span-1 flex flex-col gap-2">
                        <label for="message" class="text-text-secondary font-semibold">Message</label>
                        <textarea id="message" rows="5" class="border border-text-secondary rounded-md text-text-secondary w-full bg-default p-1 focus:border-text-secondary focus:border-outline-2 focus:outline-offset-2 focus:outline-text-secondary"></textarea>
                    </div>
                    <div class="col-span-1">
                        {% include('partials/primary-button.html.twig')
                            with {
                                type: 'submit',
                                ariaLabel: 'Envoyer le formulaire de contact',
                                label: 'Envoyer'
                            } only 
                        %}
                    </div>
                </form>
            </div>
            <div class="col-span-1 flex items-center justify-center">
                <img src="{{ asset('images/generated/2.png') }}" alt="Bomotel Montluçon" class="w-full aspect-video md:aspect-4/3 object-cover rounded-md">
            </div>
        </section>
    </main>
{% endblock %}
